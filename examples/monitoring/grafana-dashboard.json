  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "name": "Alertas",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "ALERTS{alertstate=\"firing\"}",
    "titleFormat": "{{alertname}}",
    "step": "30s"
   }
  ]
 },
 "panels": [
  {
   "type": "gauge",
   "title": "Claude: límite 5 h",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "max(relevo_plan_limit_percent{window=\"five_hour\"})",
     "instant": true,
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   }
  },
