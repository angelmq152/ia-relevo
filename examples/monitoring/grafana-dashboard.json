{
 "uid": "ia-01-uso",
 "title": "IA · Claude, Codex y agy",
 "tags": [
  "ia"
 ],
 "timezone": "browser",
 "refresh": "5s",
 "schemaVersion": 39,
 "time": {
  "from": "now-7d",
  "to": "now"
 },
